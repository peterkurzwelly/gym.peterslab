{
  "name": "gym-peterslab",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gym/web",
    "dev:api": "npm run build --workspace @gym/web && wrangler dev",
    "build": "npm run build --workspace @gym/web",
    "test": "npm run data:validate && npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspace @gym/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "data:build": "node scripts/build-exercises.mjs",
    "data:validate": "node scripts/validate-data.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261104.1": true
  }
}
